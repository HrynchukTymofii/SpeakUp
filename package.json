{
  "name": "speakup",
  "private": true,
  "description": "SpeakUp — speaking & communication skills trainer (monorepo root)",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @speakup/db generate",
    "db:migrate": "pnpm --filter @speakup/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @speakup/db migrate:deploy",
    "db:reset": "pnpm --filter @speakup/db migrate:reset",
    "db:seed": "pnpm --filter @speakup/db seed",
    "db:studio": "pnpm --filter @speakup/db studio",
    "cdk:synth": "pnpm --filter @speakup/infra synth",
    "cdk:diff": "pnpm --filter @speakup/infra diff",
    "cdk:deploy": "pnpm --filter @speakup/infra deploy"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
