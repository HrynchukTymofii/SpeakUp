# SpeakUp environment variables.
# Copy to `.env` in the repo root (`cp .env.example .env`). Every app loads this one file in dev.
# Never commit `.env`. Only NEXT_PUBLIC_* values are ever exposed to the browser.
# Vars marked (M<n>) are not required until that milestone.

# ───────────── shared ─────────────
NODE_ENV=development
# Postgres from infra/docker-compose.yml (host port 5433)
DATABASE_URL=postgresql://speakup:speakup@localhost:5433/speakup
# Redis from infra/docker-compose.yml (BullMQ queue + rate limits)
REDIS_URL=redis://localhost:6379

# ───────────── web (apps/web) ─────────────
# Base URL of apps/api as seen from the browser
NEXT_PUBLIC_API_URL=http://localhost:4000
# (M2) Clerk — https://dashboard.clerk.com → API keys. The API also uses CLERK_SECRET_KEY.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Where our own Clerk pages live, and where to land after sign-in/up when there is no redirect target
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app
# (M6) Paddle Billing client-side token (public by design, starts with test_ in sandbox)
# + environment (sandbox | production). Paddle → Developer tools → Authentication → Client-side tokens.
# Empty token = the upgrade buttons show "checkout isn't configured".
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
# (M5.5) Cloudflare Turnstile site key (public half of the bot check).
# Empty in dev = Cloudflare's always-pass test key. https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# (M5.5) Mini-lesson video shown in the funnel. Public file in the S3 media bucket (stack output
# MediaBaseUrl + file name); upload a new version under a new name (…-v2.mp4) so caches don't serve
# the old one. Empty = a "Video coming soon" placeholder.
NEXT_PUBLIC_FUNNEL_LESSON_VIDEO_URL=https://speakup-mediaa721a567-fpcn5of31ro1.s3.us-east-1.amazonaws.com/media/funnel-fillers-v1.mp4

# ───────────── api (apps/api) ─────────────
API_PORT=4000
# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# (M4) S3 bucket for recordings (private). Region us-east-1 (US-first; keep it near the DB).
# Option A (no AWS account): LocalStack from docker-compose creates `speakup-recordings-dev`;
#   keep S3_ENDPOINT=http://localhost:4566 and the dummy keys "test"/"test".
# Option B (real AWS, recommended before M5): your bucket name, S3_ENDPOINT EMPTY, and the
#   access key of a dev IAM user limited to <bucket>/recordings/* (see README "Recordings storage").
# In prod the ECS task IAM role provides credentials and the two key vars stay unset.
AWS_REGION=us-east-1
S3_BUCKET=speakup-recordings-dev
# Local S3 emulator (LocalStack). Leave EMPTY for real AWS S3.
S3_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# (M6) Paddle Billing (server side). Optional in dev (billing routes answer 503 without them),
# required in production. See README "Payments (Paddle sandbox)".
PADDLE_ENV=sandbox
# Developer tools → Authentication → API keys (sandbox keys differ from live ones)
PADDLE_API_KEY=
# Developer tools → Notifications → your destination → secret key (pdl_ntfset_…)
PADDLE_WEBHOOK_SECRET=
# Catalog → Products → SpeakUp Pro → the monthly price id (pri_…)
PADDLE_PRICE_ID_PRO_MONTHLY=
# (M5.5) Cloudflare Turnstile secret (bot check on anonymous funnel recording).
# Empty in dev = the always-pass test secret; the API refuses to start in production without a real one.
TURNSTILE_SECRET_KEY=
# Max anonymous funnel analyses per IP per day
FUNNEL_IP_DAILY_LIMIT=3
# (M5.5) Secret for hashing visitor IPs (we store only HMAC(ip), never the IP).
# Empty in dev = a fixed dev value; production requires a random one (e.g. `openssl rand -hex 32`).
IP_HASH_SECRET=
# Daily analysis quotas per plan
FREE_DAILY_ANALYSES=3
PRO_DAILY_ANALYSES=50
# (M7) Rate limits (Redis-backed, shared by all API instances): requests per minute per IP on all
# routes (health checks and webhooks excluded), and new recordings per minute per signed-in user.
RATE_LIMIT_PER_MINUTE=300
ATTEMPTS_PER_MINUTE=10
# (M8) Production only: number of proxies in front of the API (the AWS load balancer = 1).
# The client IP is read that many hops from the right of X-Forwarded-For.
TRUST_PROXY_HOPS=1

# ───────────── worker (apps/worker) ─────────────
# How many analysis jobs one worker process runs in parallel
WORKER_CONCURRENCY=2
# The worker also uses DATABASE_URL, REDIS_URL and the AWS_* / S3_* values above
# (it creates short-lived download links for Deepgram; needs s3:GetObject on recordings/*).
# ffmpeg binary used to decode recordings for pitch / loudness / pause analysis. Default
# "ffmpeg" (on PATH; the Docker image installs it). Without ffmpeg the worker still runs but
# falls back to transcript-only metrics (no voice analysis, rougher pauses).
FFMPEG_PATH=
# (M5) Deepgram speech-to-text — https://console.deepgram.com → API keys
DEEPGRAM_API_KEY=
# (M5) Anthropic Claude API — https://platform.claude.com → API keys.
# Also set a monthly spend limit there (cost guardrail, SPEC §9).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# (M5) Unit prices used to estimate cost per analysis (Analysis.costUsdMicros).
# Fill from the provider pricing pages; empty = 0. Deepgram Nova-3 pre-recorded monolingual
# (pay-as-you-go): $0.0043/min. Claude Sonnet 5.5 list price: $2 in / $10 out per MTok.
PRICE_STT_USD_PER_MIN=0.0043
PRICE_LLM_INPUT_USD_PER_MTOK=2
PRICE_LLM_OUTPUT_USD_PER_MTOK=10

# ───────────── db seed (packages/db) ─────────────
# Placeholder video URL used for every seeded lesson. Empty → lessons have no video yet.
SEED_LESSON_VIDEO_URL=
