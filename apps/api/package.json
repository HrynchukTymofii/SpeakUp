{
  "name": "@speakup/api",
  "version": "0.0.0",
  "private": true,
  "description": "SpeakUp REST API (Fastify)",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1171.0",
    "@aws-sdk/s3-presigned-post": "3.1171.0",
    "@clerk/backend": "3.30.0",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@paddle/paddle-node-sdk": "3.12.0",
    "@sentry/node": "11.11.0",
    "@speakup/db": "workspace:*",
    "@speakup/shared": "workspace:*",
    "bullmq": "6.7.7",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "5.11.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15"
  }
}
