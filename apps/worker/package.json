{
  "name": "@speakup/worker",
  "version": "0.0.0",
  "private": true,
  "description": "SpeakUp background worker (BullMQ): STT → metrics → LLM feedback",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@aws-sdk/client-cloudwatch": "3.1171.0",
    "@aws-sdk/client-s3": "3.1171.0",
    "@aws-sdk/s3-request-presigner": "3.1171.0",
    "@speakup/db": "workspace:*",
    "@speakup/shared": "workspace:*",
    "bullmq": "6.7.7",
    "ioredis": "5.11.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15"
  }
}
