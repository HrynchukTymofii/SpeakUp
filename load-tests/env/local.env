# Local load-test environment (docs/load-testing.md). LOCAL-ONLY values, nothing secret:
# every key below is a dummy that only works against the Docker stack from `pnpm infra:up`.
# NODE_ENV=production so the API/worker log JSON and behave like the deployed containers.
NODE_ENV=production
DATABASE_URL=postgresql://speakup:speakup@localhost:5433/speakup
# Own Redis database (index 5): the dev stack shares this Redis, and a dev worker must never
# pick up load-test jobs.
REDIS_URL=redis://localhost:6379/5
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=speakup-recordings-dev
S3_ENDPOINT=http://localhost:4566

# API
API_PORT=4100
CORS_ORIGINS=http://localhost:3000
CLERK_SECRET_KEY=sk_test_loadtest_dummy
TURNSTILE_SECRET_KEY=loadtest-dummy-turnstile
IP_HASH_SECRET=loadtest-dummy-ip-hash-secret
PADDLE_API_KEY=loadtest-dummy
PADDLE_WEBHOOK_SECRET=loadtest-dummy
PADDLE_PRICE_ID_PRO_MONTHLY=pri_loadtest
TRUST_PROXY_HOPS=0
# k6 runs from one IP; the per-IP limit would measure the limiter, not the system.
RATE_LIMIT_PER_MINUTE=1000000
# Each virtual user records many times; the daily free quota (3) would stop them.
FREE_DAILY_ANALYSES=100000
LOAD_TEST_AUTH_SECRET=local-load-test-secret-0123456789abcdef
LOAD_TEST_STACK=true

# Worker: same size as production (1 task, concurrency 4), fake paid providers.
WORKER_CONCURRENCY=4
ANALYSIS_PROVIDERS=fake
FAKE_STT_MEDIAN_MS=1000
FAKE_LLM_MEDIAN_MS=2000
FAKE_FAILURE_RATE=0
